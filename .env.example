# Konfigurasi Server
PORT=3000

# Path absolut ke folder arsip Anda
# Contoh Windows: C:/DataArsip atau C:\DataArsip
# Contoh Linux/Mac: /var/archives atau /home/user/arsip
ARCHIVE_DIR_PATH=C:/DataArsip

# Nama aplikasi (tampil di browser title)
APP_NAME=Local Archive System

# ─── Konfigurasi Auto-Scan ───────────────────────────────────────────────────
# Nama subfolder di dalam ARCHIVE_DIR_PATH untuk menerima hasil scan
# File yang masuk ke folder ini akan di-rename dan di-tag otomatis
SCAN_SUBFOLDER=Scan

# Prefix nama file hasil scan (format: PREFIX_YYYYMMDD_NNN.ext)
SCAN_PREFIX=Scan

# Tag yang ditambahkan otomatis ke file hasil scan (pisahkan dengan koma)
SCAN_TAGS=scan,arsip-digital
